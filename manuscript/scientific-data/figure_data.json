    "fig07_about": {
      "data": {
        "cards": [
          {
            "body": "One queryable district record for India, 1901–2100, that keeps reconstruction, observation-based gridded products and model projections separate, labelled and reproducible. Built for research, teaching and communication.",
            "heading": "Purpose"
          },
          {
            "body": "Era A Atlas 1901–2025 · Era B gridded 1981–2026 · Era C projections 2015–2100 · Era A–B cross-validation. Twelve dashboard windows, district profiles and CSV, Parquet and SQL access.",
            "heading": "Products"
          },
          {
            "body": "Apache Parquet with DuckDB-WASM in a Web Worker, HTTP Range reads over static files, Leaflet maps and Plotly charts. No backend, no accounts and no server-side query log; the published snapshot is immutable.",
            "heading": "Technology"
          },
          {
            "body": "Complements operational monitors such as the India Drought Monitor and IMD products with archive depth, several indicator families, reproducibility and projections. It is a research instrument, not an operational warning service.",
            "heading": "Positioning"
          }
        ],
        "sentence": "Purpose, products, technology and research positioning. An interactive, fully client-side geospatial platform for exploring drought indicators across Indian districts, built for historical analysis and research communication — not operational monitoring.",
        "stats": {
          "0": "servers",
          "10": "indicators",
          "3": "labelled eras",
          "36": "States/UTs",
          "724": "districts"
        }
      },
